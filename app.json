{
  "expo": {
    "name": "Switchifye",
    "slug": "switchifye-app",
    "scheme": "switchifye",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.switchifye.app",
      "usesAppleSignIn": true,
      "newArchEnabled": false,
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": []
      },
      "infoPlist": {
        "NSUserNotificationUsageDescription": "We'll remind you to check in so your switch doesn't trigger",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.switchifye.app",
      "newArchEnabled": false,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#3B82F6",
          "defaultChannel": "checkin-reminders"
        }
      ],
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-apple-authentication",
      "react-native-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.0",
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# react-native-nitro-modules / react-native-iap: native code resolves these classes by name\n-keep class com.margelo.nitro.** { *; }\n# expo-notifications: mirrors its own proguard-rules.pro, which isn't declared as consumer rules\n-keep class expo.modules.notifications.** { *; }\n# react-native-webview: JS bridge methods are called by name\n-keepclassmembers class * { @android.webkit.JavascriptInterface <methods>; }"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "807eb2aa-5ce0-4599-b7ac-8f58e8fcf471"
      }
    }
  }
}